{
  "name": "@pepper/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "media:smoke": "node scripts/media-smoke.mjs",
    "swipe:smoke": "node scripts/swipe-race-smoke.mjs",
    "realtime:smoke": "node scripts/realtime-smoke.mjs",
    "realtime:cross-client": "node scripts/cross-client-realtime-smoke.mjs",
    "match-event:smoke": "node scripts/match-event-smoke.mjs",
    "unmatch:smoke": "node scripts/unmatch-smoke.mjs",
    "billing:smoke": "node scripts/billing-smoke.mjs",
    "safety:smoke": "node scripts/safety-lifecycle-smoke.mjs",
    "product:smoke": "node scripts/product-flow-smoke.mjs",
    "lint": "eslint src test --max-warnings=0",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^2.0.0",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "blurhash": "^2.0.5",
    "bullmq": "^5.34.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.5.1",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.11.20",
    "nodes2ts": "^4.0.2",
    "pg": "^8.13.1",
    "redis": "^5.0.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.0.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
