# Required
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# App
APP_NAME=Portfolio CMS API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
PORT=3000
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=https://example.com
RATE_LIMIT_PER_MINUTE=60
FRONTEND_URL=https://example.com
SITE_URL=https://example.com
LOCAL_MEDIA_ROOT=media
TAX_RATE=0.08

# Optional hosted Redis. Leave unset to use Neon kv_store.
REDIS_URL=

# Hostinger Email SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=notifications@example.com
SMTP_PASSWORD=
SMTP_FROM=notifications@example.com

# Optional payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_ENVIRONMENT=sandbox
MOMO_CALLBACK_URL=
MOMO_CALLBACK_SECRET=

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Optional AI gateway
CMU_API_GATEWAY_URL=
CMU_API_KEY=
CMU_LLM_MODEL=gpt-4o
CMU_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Existing Python provisioning compatibility
DATABASE_URL_SYNC=
FIRST_SUPERADMIN_EMAIL=
FIRST_SUPERADMIN_PASSWORD=
