# Safe local defaults. Copy to .env; never commit real credentials.
APP_NAME=Pepper
NODE_ENV=development
JWT_SECRET=unsafe-local-development-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,api
DATABASE_URL=postgresql://pepper:pepper@db:5432/pepper
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=pepper
S3_SECRET_KEY=pepper-local-secret
S3_BUCKET=pepper-media
# console prints OTPs only in development.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=Pepper
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
# fake succeeds only outside production.
PAYMENT_PROVIDER=fake
# Provider credentials are optional in development; fake is rejected in production.
APPLE_BUNDLE_ID=com.easytechsolutionz.pepper
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=
APPLE_ROOT_CA_FILES=
APPLE_ENVIRONMENT=sandbox
# Numeric App Store Connect app ID; leave empty outside Apple production setup.
APPLE_APP_ID=
GOOGLE_PACKAGE_NAME=com.easytechsolutionz.pepper
GOOGLE_SERVICE_ACCOUNT_FILE=
ORANGE_MONEY_API_URL=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=
MTN_MOMO_API_URL=
MTN_MOMO_API_KEY=
MTN_MOMO_WEBHOOK_SECRET=
BILLING_WEBHOOK_BASE_URL=http://localhost:8000/api/v1/billing/webhooks
MODERATION_PROVIDER=auto_approve
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_FILE=
# Generate a Fernet key before storing sensitive production data.
FIELD_ENCRYPTION_KEY=unsafe-local-field-key-change-me
SENTRY_DSN=
