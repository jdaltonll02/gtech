# Backend-level gitignore (also enforced by root .gitignore when git is at root)

.env
.env.*
*.env
!.env.example

venv/
.venv/
env/

__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

celerybeat-schedule
celerybeat-schedule.db
celerybeat.pid

media/*
!media/.gitkeep

*.sqlite3
*.db
*.log
