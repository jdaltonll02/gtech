# ─────────────────────────────────────────────────────────────────────────────
# Secrets & environment variables — NEVER commit real credentials
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
*.env
# Re-allow example/sample templates (placeholders only, no real values)
!.env.example
!.env.sample
!**/.env.example
!**/.env.sample

# ─────────────────────────────────────────────────────────────────────────────
# Migration/disaster-recovery backups (scripts/backup.sh) — contain live
# secrets and a full database dump, never commit these
# ─────────────────────────────────────────────────────────────────────────────
backups/
*.tar.gz

# ─────────────────────────────────────────────────────────────────────────────
# SSL / TLS certificates & private keys
# ─────────────────────────────────────────────────────────────────────────────
certs/
ssl/
*.pem
*.key
*.crt
*.cer
*.cert
*.p12
*.pfx
*.der
*.jks

# ─────────────────────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
*venv/
*.venv/
venv/
env/
ENV/
.env.venv/

# Build / distribution
*.egg
*.egg-info/
.eggs/
dist/
build/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
MANIFEST

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/
.tox/
.nox/
nosetests.xml
pytestdebug.log

# Type checkers & linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# Celery
celerybeat-schedule
celerybeat-schedule.db
celerybeat.pid
celery_worker.log

# Local databases
*.sqlite3
*.db

# ─────────────────────────────────────────────────────────────────────────────
# Node / Frontend
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
.npm
.eslintcache
.stylelintcache
*.tsbuildinfo

# ─────────────────────────────────────────────────────────────────────────────
# IDE & editor files
# ─────────────────────────────────────────────────────────────────────────────
# VS Code — ignore workspace settings; .vscode/extensions.json may be committed
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.#*

# ─────────────────────────────────────────────────────────────────────────────
# OS-generated files
# ─────────────────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ─────────────────────────────────────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pip-log.txt

# ─────────────────────────────────────────────────────────────────────────────
# Docker
# ─────────────────────────────────────────────────────────────────────────────
# Local override files should never be committed
docker-compose.override.yml
docker-compose.local.yml
.dockerignore.local

# ─────────────────────────────────────────────────────────────────────────────
# Alembic
# ─────────────────────────────────────────────────────────────────────────────
# Version files are tracked; autogenerated temp files are not
backend/alembic/versions/__pycache__/

# ─────────────────────────────────────────────────────────────────────────────
# Media uploads — served from Docker volume in production, not tracked in git
# ─────────────────────────────────────────────────────────────────────────────
backend/media/*
!backend/media/.gitkeep

# ─────────────────────────────────────────────────────────────────────────────
# Miscellaneous
# ─────────────────────────────────────────────────────────────────────────────
# Temporary files
*.tmp
*.temp
*.bak
*.orig
*.rej

# Compiled output
*.com
*.class
*.dll
*.exe
*.o
*.so

# Package manager locks — keep package-lock.json / poetry.lock tracked
# (deterministic installs in CI/CD), but ignore local pip artifacts
pip-selfcheck.json
